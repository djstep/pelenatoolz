# App
APP_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"
AUTH_TRUST_HOST="true"

# Database (PostgreSQL)
DATABASE_URL=""
DIRECT_URL=""

# Кто может зарегистрироваться без приглашения и создавать проекты. Адреса через запятую, точку
# с запятой или пробел, регистр не важен. Пусто — регистрация только по приглашению, проекты не создать.
REGISTRATION_ALLOWLIST=""

# База e2e. Значения живут только в .env.e2e, здесь оставить пустыми. Отката на .env нет.
# E2E_DATABASE_URL — адрес через пул (pooled), E2E_DIRECT_URL — прямой (direct).
E2E_DATABASE_URL=
E2E_DIRECT_URL=

# Google Drive OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Yandex Disk OAuth — https://oauth.yandex.ru/
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Ключ шифрования токенов Google/Яндекс Диска и подписи state. Пусто — берётся AUTH_SECRET.
# В production нужен один из двух, не короче 32 символов. Смена ключа — все диски переподключать
# заново: на сервере, где его раньше не было, новый не задавать (docs/audit/FIX_REPORT_3.md).
CLOUD_TOKEN_SECRET=""

# Адрес сайта для redirect URI дисков: берётся APP_URL, без него — NEXTAUTH_URL, без обоих —
# http://localhost:3000. Пустую строку не задавать (адрес возврата сломается) — держать закомментированным.
# NEXTAUTH_URL=""

# Optional: Cloudflare R2 (S3-compatible). Without these, files store locally under /storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL=""

# Password reset email (Resend) — https://resend.com
# RESEND_API_KEY=""
# PASSWORD_RESET_FROM="PELENA <noreply@yourdomain.com>"
