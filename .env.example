# App
APP_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"
AUTH_TRUST_HOST="true"

# Database (Neon)
DATABASE_URL=""
DIRECT_URL=""

# Google Drive OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
