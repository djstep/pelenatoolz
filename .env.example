# Yandex Disk OAuth — https://oauth.yandex.ru/
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Optional: Cloudflare R2 (S3-compatible). Without these, files store locally under /storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL=""

# Password reset email (Resend) — https://resend.com
# RESEND_API_KEY=""
# PASSWORD_RESET_FROM="PELENA <noreply@yourdomain.com>"
