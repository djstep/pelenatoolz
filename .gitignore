# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# настройки запуска на своём компьютере
.claude/launch.json

# vercel
.vercel

/public/uploads
/storage
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

# превью печатных листов (npm run preview:callsheet)
/preview/

# приёмка (Playwright): сессии входа, отчёты и скриншоты
/e2e/.auth/
/e2e/screenshots/
/e2e/.downloads/
/test-results/
/playwright-report/

# снимки дизайна: в git только пары «эскиз / наш» (compare-*), остальное — локально
/docs/tasks/ref/design/out/**
!/docs/tasks/ref/design/out/**/
!/docs/tasks/ref/design/out/**/compare-*
