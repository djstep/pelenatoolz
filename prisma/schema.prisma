generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  SERIES
  FEATURE
  SHORT
}

enum ProjectStatus {
  DRAFT
  PREPROD
  SHOOTING
  POST
  DONE
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum TimingMode {
  MINUTES
  PAGES
  IMPORTED
  MANUAL
}

enum SceneStatus {
  SHOT
  RESHOOT_REQUIRED
  PLANNING
  OFF_PLAN
  NOT_SHOT
}

enum ProductionSceneFactStatus {
  SHOT
  NOT_SHOT
  RESHOOT_REQUIRED
  DELETED
}

enum IntExt {
  INT
  EXT
  INT_EXT
}

enum LocationKind {
  EXT
  INT
  INT_EXT
  PAV
}

enum SceneKind {
  SCENE
  SOUND_DUB
  MASTER_SHOT
  FOOTAGE
}

enum ScriptVersionSourceType {
  IMPORTED_DOCX
  IMPORTED_OTHER
  MANUAL
  DUPLICATED_FROM
}

/// Screenplay block types for the full-script editor.
enum ScriptCommentStatus {
  OPEN
  RESOLVED
}

enum ScriptBlockType {
  SLUGLINE
  SCENE_CAST
  ACTION
  CHARACTER
  DIALOGUE
  PARENTHETICAL
  SUPER
  TRANSITION
  NOTE
  BONEYARD
  SCENE_GROUP
  FOLDER
}

enum DayNight {
  DAY
  NIGHT
  DAWN
  DUSK
}

enum ElementType {
  PROP
  VEHICLE
  WARDROBE
  SFX
  MAKEUP
  COSTUME
  OTHER
}

enum SceneResourceCategory {
  EXTRAS
  GROUP
  STUNT
  MAKEUP
  COSTUME
  PROP
  VEHICLE
  CAMERA
  CUSTOM
}

enum TimeSlotType {
  MAKEUP_COSTUME
  REHEARSAL
  SHOOTING
  LUNCH
  TRAVEL
  IDLE
}

enum ShootDayStatus {
  PLANNED
  CONFIRMED
  SHOT
  CANCELLED
}

enum ShootDayType {
  WORKING
  OFF
  REST
  PREP
}

enum ActorRoleType {
  LEAD
  SUPPORTING
  EPISODIC
}

enum ContractorType {
  IP
  INDIVIDUAL
  SELF_EMPLOYED
  UNKNOWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CastingCandidateStatus {
  CONSIDERING
  APPLICATION_SENT
  CASTING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProjectFileKind {
  IMAGE
  VIDEO
  OTHER
}

enum ProjectFileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ScoutCandidateStatus {
  CONSIDERING
  NEGOTIATION
  APPROVED
  REJECTED
}

enum ActorAvailabilityStatus {
  UNSET
  FREE
  BUSY_OTHER
  BUSY_OUR_PROJECT
  UNAVAILABLE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ProjectMembership[]
  createdProjects Project[]           @relation("ProjectCreator")
  createdInvites  ProjectInvite[]     @relation("InviteCreator")
  auditLogs       AuditLog[]
  cloudConnections CloudConnection[]
  passwordResetTokens PasswordResetToken[]
  scriptVersions  ScriptVersion[]
  scriptComments  ScriptComment[]
  castingCandidateComments CastingCandidateComment[]
  createdAuditions Audition[]         @relation("AuditionCreator")
  uploadedFiles   ProjectFile[]       @relation("FileUploader")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  fullName    String?
  description String?
  type        ProjectType
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  currency    String        @default("RUB")
  timezone    String        @default("Europe/Moscow")
  city        String?

  episodeCount         Int?
  episodeRuntimeMin    Int?
  shootingDaysCount    Int?
  cameraUnits          Int?        @default(1)
  cameraCount          Int?        @default(1)
  timingMode           TimingMode  @default(MINUTES)
  pageToMinuteRatio    Decimal     @default(1) @db.Decimal(6, 2)
  plannedDailyOutputMin Decimal?   @db.Decimal(8, 2)
  shootOnFilm          Boolean     @default(false)
  filmType             String?
  filmCoefficient      Decimal?    @db.Decimal(6, 2)
  calcCalendarDays     Boolean     @default(true)

  /// Раскладки столбцов табличных экспортов (либретто, КПП, …)
  exportSettings       Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User                    @relation("ProjectCreator", fields: [createdById], references: [id])
  memberships ProjectMembership[]
  invites     ProjectInvite[]
  roles       ProjectRoleDefinition[]
  scenes      Scene[]
  locations   Location[]
  characters  Character[]
  elements    Element[]
  shootDays   ShootDay[]
  actors      Actor[]
  castingPeople CastingPerson[]
  castingCandidates CastingCandidate[]
  auditions     Audition[]
  auditionSchedules AuditionSchedule[]
  auditionScheduleBreaks AuditionScheduleBreak[]
  projectFiles  ProjectFile[]
  scoutCandidates ScoutCandidate[]
  auditLogs   AuditLog[]
  budgetLines BudgetLine[]
  financeOps  FinanceOperation[]
  postTasks   PostTask[]
  cloudFiles  CloudFileLink[]
  scriptVersions ScriptVersion[]
  scriptBlocks ScriptBlock[]
  resourceCategories ResourceCategory[]
  actorAvailabilityRows ActorAvailabilityRow[]
  payments Payment[]

  @@index([createdById])
  @@index([status])
}

/// Custom project role with JSON permission matrix.
model ProjectRoleDefinition {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  note        String?
  isSystem    Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships ProjectMembership[]
  invites     ProjectInvite[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectMembership {
  id        String           @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    ProjectRoleDefinition @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, status])
}

model ProjectInvite {
  id          String    @id @default(cuid())
  projectId   String
  email       String?
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRoleDefinition @relation(fields: [roleId], references: [id])
  createdBy User                  @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([email])
}

model Scene {
  id              String      @id @default(cuid())
  projectId       String
  episodeNumber   Int         @default(0)
  number          String
  postfix         String      @default("")
  title           String?
  summary         String?
  description     String?
  scriptContent   String?
  scriptDay       Int?
  objectType      String?
  sceneKind       SceneKind   @default(SCENE)
  shootingUnit    String?
  montageMap      String?
  pageCount       Decimal?    @db.Decimal(6, 2)
  planSeconds     Int?
  factSeconds     Int?
  preEditSeconds  Int?
  editSeconds     Int?
  filmFootagePlan Decimal?    @db.Decimal(10, 2)
  filmFootageFact Decimal?    @db.Decimal(10, 2)
  intExt          IntExt?
  dayNight        DayNight?
  status          SceneStatus @default(PLANNING)
  statusDate      DateTime?
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locations      SceneLocation[]
  characters     SceneCharacter[]
  elements       SceneElement[]
  resources      SceneResource[]
  resourceItems  SceneResourceItem[]
  shootDayScenes  ShootDayScene[]
  timeSlots       ShootDayTimeSlot[]
  scriptBlocks    ScriptBlock[]
  productionFacts ProductionReportSceneFact[]
  auditions       Audition[]

  @@unique([projectId, episodeNumber, number, postfix])
  @@index([projectId, sortOrder])
}

model Location {
  id             String        @id @default(cuid())
  projectId      String
  name           String
  sublocation    String?
  locationKind   LocationKind?
  hasDecoration  Boolean       @default(false)
  address        String?
  tags           String?
  notes          String?
  requirementNotes String?
  scoutSnapshot  Json?
  sourceScoutCandidateId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  SceneLocation[]
  photos  LocationPhoto[]
  scoutCandidateLinks ScoutCandidateLocation[]
  workRows ProductionReportWorkRow[]

  @@index([projectId])
}

model LocationPhoto {
  id         String   @id @default(cuid())
  locationId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, sortOrder])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  roleRequirements String?
  /// Тип роли для фильтров кастинга/проб (главная / второго плана / эпизод)
  roleType         ActorRoleType?
  makeupOffsetMin  Int?
  costumeOffsetMin Int?
  castSnapshot Json?
  sourceCastingCandidateId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  SceneCharacter[]
  actors  Actor[]
  castingCandidates CastingCandidate[]
  auditionLinks AuditionActor[]

  @@index([projectId])
}

model CastingPerson {
  id               String   @id @default(cuid())
  projectId        String
  photoUrl         String?
  lastName         String
  firstName        String?
  middleName       String?
  /// Дата рождения — возраст считается на момент экспорта
  birthDate        DateTime? @db.Date
  education        String?
  filmography      String?
  phone            String?
  email            String?
  agentName        String?
  agentPhone       String?
  agentEmail       String?
  physicalParams   Json?
  skills           String[] @default([])
  proposedRate     Decimal? @db.Decimal(12, 2)
  proposedTerms    String?
  tags             String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidates CastingCandidate[]
  availabilityRows ActorAvailabilityRow[]
  auditionLinks AuditionActor[]

  @@index([projectId])
}

model CastingCandidate {
  id              String                 @id @default(cuid())
  projectId       String
  characterId     String
  personId        String
  status          CastingCandidateStatus @default(CONSIDERING)
  statusChangedAt DateTime               @default(now())
  /// Оценка кастинга 1–5 (для фильтров и планирования проб)
  rating          Int?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  person    CastingPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  scheduleLinks AuditionScheduleCandidate[]
  comments  CastingCandidateComment[]

  @@unique([characterId, personId])
  @@index([projectId, status])
  @@index([personId])
}

/// Комментарий к кандидату на роль (автор + дата).
model CastingCandidateComment {
  id          String   @id @default(cuid())
  candidateId String
  authorId    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate CastingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([authorId])
}

/// Файл проекта (видео проб и др.). storageKey — локальный путь или ключ R2.
model ProjectFile {
  id           String            @id @default(cuid())
  projectId    String
  kind         ProjectFileKind
  status       ProjectFileStatus @default(UPLOADING)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  /// Публичный/прокси URL для воспроизведения (заполняется когда READY)
  url          String?
  thumbnailUrl String?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("FileUploader", fields: [createdById], references: [id], onDelete: SetNull)
  auditions Audition[]

  @@index([projectId, kind])
  @@index([status])
}

model Audition {
  id           String   @id @default(cuid())
  projectId    String
  videoFileId  String?
  /// Альтернатива загрузке: YouTube / облако
  externalUrl  String?
  date         DateTime @db.Date
  time         String?
  sceneId      String?
  isSelfTape   Boolean  @default(false)
  /// Избранная проба (для фильтра при экспорте каст-листа)
  isFavorite   Boolean  @default(false)
  comment      String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoFile ProjectFile?     @relation(fields: [videoFileId], references: [id], onDelete: SetNull)
  scene     Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  createdBy User             @relation("AuditionCreator", fields: [createdById], references: [id])
  actors    AuditionActor[]

  @@index([projectId, date])
  @@index([sceneId])
  @@index([videoFileId])
}

/// Участник пробы (кандидат кастинга). Тип сольная/парная/ансамбль — по count(actors).
model AuditionActor {
  id          String  @id @default(cuid())
  auditionId  String
  personId    String
  characterId String?

  audition  Audition      @relation(fields: [auditionId], references: [id], onDelete: Cascade)
  person    CastingPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  character Character?    @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([auditionId, personId])
  @@index([personId])
  @@index([characterId])
}

/// Запланированный слот пробы (календарь планирования).
model AuditionSchedule {
  id        String   @id @default(cuid())
  projectId String
  date      DateTime @db.Date
  time      String
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidates AuditionScheduleCandidate[]

  @@index([projectId, date])
}

model AuditionScheduleCandidate {
  id                 String @id @default(cuid())
  scheduleId         String
  castingCandidateId String

  schedule  AuditionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  candidate CastingCandidate @relation(fields: [castingCandidateId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, castingCandidateId])
  @@index([castingCandidateId])
}

/// Технический перерыв / обед в плане кастинг-проб (тот же TimeSlotType, что в КПП).
model AuditionScheduleBreak {
  id        String       @id @default(cuid())
  projectId String
  date      DateTime     @db.Date
  time      String
  /// Длительность ЧЧ:ММ (как в шаблонах перерывов КПП)
  duration  String       @default("01:00")
  slotType  TimeSlotType
  label     String
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model ScoutCandidate {
  id              String               @id @default(cuid())
  projectId       String
  title           String
  address         String?
  cost            Decimal?             @db.Decimal(12, 2)
  contactName     String?
  contactPhone    String?
  photos          Json?
  videos          Json?
  notes           String?
  status          ScoutCandidateStatus @default(CONSIDERING)
  statusChangedAt DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationLinks  ScoutCandidateLocation[]

  @@index([projectId, status])
}

model ScoutCandidateLocation {
  scoutCandidateId String
  locationId       String

  scoutCandidate ScoutCandidate @relation(fields: [scoutCandidateId], references: [id], onDelete: Cascade)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([scoutCandidateId, locationId])
  @@index([locationId])
}

model Element {
  id        String      @id @default(cuid())
  projectId String
  type      ElementType @default(PROP)
  name      String
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  SceneElement[]

  @@index([projectId])
}

model SceneLocation {
  sceneId    String
  locationId String

  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([sceneId, locationId])
}

model SceneCharacter {
  sceneId     String
  characterId String

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([sceneId, characterId])
}

model SceneElement {
  sceneId   String
  elementId String

  scene   Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  element Element @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@id([sceneId, elementId])
}

model SceneResource {
  id        String                @id @default(cuid())
  sceneId   String
  category  SceneResourceCategory
  name      String
  quantity  Int                   @default(1)
  unitPrice Decimal               @default(0) @db.Decimal(12, 2)
  total     Decimal               @default(0) @db.Decimal(12, 2)

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

model ResourceCategory {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  sortOrder    Int      @default(0)
  fillInScenes Boolean  @default(true)
  perShift     Boolean  @default(false)
  countable    Boolean  @default(false)
  showInKpp    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ResourceItem[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

model ResourceItem {
  id                String   @id @default(cuid())
  categoryId        String
  name              String
  notes             String?
  shiftRate         Decimal? @db.Decimal(12, 2)
  shiftHoursMin     Int?
  unpaidOvertimeMin Int?
  arrivalOffsetMin  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category     ResourceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sceneLinks   SceneResourceItem[]
  shiftUsages  ShootDayResourceUsage[]
  workRows     ProductionReportWorkRow[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model SceneResourceItem {
  id       String @id @default(cuid())
  sceneId  String
  itemId   String
  quantity Int    @default(1)

  scene Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  item  ResourceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sceneId, itemId])
  @@index([itemId])
}

model ShootDayResourceUsage {
  id          String  @id @default(cuid())
  shootDayId  String
  itemId      String
  isUsed      Boolean @default(true)
  arrivalTime String?
  readyTime   String?
  wrapTime    String?

  shootDay ShootDay     @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  item     ResourceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([shootDayId, itemId])
}

model ShootDay {
  id          String         @id @default(cuid())
  projectId   String
  date        DateTime
  dayNumber   Int
  unit        String?        @default("main")
  shiftNumber Int?
  dayType     ShootDayType   @default(WORKING)
  isLocked    Boolean        @default(false)
  isNightShift Boolean       @default(false)
  callTime    String?
  wrapTime    String?
  shiftStartTime   String?
  rehearsalTime    String?
  motorOnTime      String?
  motorOffTime     String?
  crewMeetAddress  String?
  crewMeetTime     String?
  weatherNote      String?
  weatherPrecip    String?
  notes       String?
  comment     String?
  prepNote    String?
  status      ShootDayStatus @default(PLANNED)
  callSheetSavedAt     DateTime?
  callSheetPlanLocked Boolean @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes           ShootDayScene[]
  departmentCalls  DepartmentCallTime[]
  transports       ShootDayTransport[]
  timeSlots        ShootDayTimeSlot[]
  actorCalls       ShootDayActorCall[]
  resourceCalls    ShootDayResourceCall[]
  resourceUsages   ShootDayResourceUsage[]
  productionReport ProductionReport?
  payments         Payment[]

  @@unique([projectId, dayNumber])
  @@index([projectId, date])
}

model DepartmentCallTime {
  id         String @id @default(cuid())
  shootDayId String
  roleLabel  String
  personName String?
  phone      String?
  callTime   String?
  sortOrder  Int    @default(0)

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@index([shootDayId, sortOrder])
}

model ShootDayTransport {
  id         String  @id @default(cuid())
  shootDayId String
  name       String
  callTime   String?
  notes      String?
  sortOrder  Int     @default(0)

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@index([shootDayId, sortOrder])
}

model ShootDayTimeSlot {
  id         String       @id @default(cuid())
  shootDayId String
  startTime  String
  endTime    String?
  slotType   TimeSlotType
  sceneId    String?
  notes      String?
  sortOrder  Int          @default(0)

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  scene    Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([shootDayId, sortOrder])
}

model ShootDayActorCall {
  id          String  @id @default(cuid())
  shootDayId  String
  actorId     String
  pickupTime  String?
  arrivalTime String?
  makeupTime  String?
  costumeTime String?
  readyTime   String?
  wrapTime    String?
  notes       String?

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  actor    Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([shootDayId, actorId])
}

model ShootDayResourceCall {
  id          String @id @default(cuid())
  shootDayId  String
  category    String
  name        String
  arrivalTime String?
  costumeTime String?
  makeupTime  String?
  readyTime   String?
  wrapTime    String?

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@unique([shootDayId, category, name])
}

model ShootDayScene {
  id             String   @id @default(cuid())
  shootDayId     String
  sceneId        String
  sortOrder      Int      @default(0)
  estimatedPages Decimal? @db.Decimal(6, 2)
  notes          String?

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([shootDayId, sceneId])
  @@index([shootDayId, sortOrder])
}

/// Факт съёмочного дня (производственный отчёт).
model ProductionReport {
  id             String   @id @default(cuid())
  shootDayId     String   @unique
  factShiftStart String?
  factShiftEnd   String?
  lunchStart     String?
  lunchEnd       String?
  breakNotes     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shootDay   ShootDay                    @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  sceneFacts ProductionReportSceneFact[]
  workRows   ProductionReportWorkRow[]
}

/// Факт по сцене в отчёте — сохраняется даже после возврата сцены в неспланированные.
model ProductionReportSceneFact {
  id               String                     @id @default(cuid())
  reportId         String
  sceneId          String
  status           ProductionSceneFactStatus  @default(NOT_SHOT)
  factSeconds      Int?
  prepStart        String?
  prepEnd          String?
  rehearsalStart   String?
  rehearsalEnd     String?
  motorStart       String?
  motorEnd         String?
  notes            String?
  sortOrder        Int                        @default(0)
  returnedToPool   Boolean                    @default(false)
  sceneLabel       String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  report      ProductionReport              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  scene       Scene                        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  montageRows ProductionReportMontageRow[]

  @@unique([reportId, sceneId])
  @@index([reportId, sortOrder])
}

model ProductionReportMontageRow {
  id           String  @id @default(cuid())
  sceneFactId  String
  scenePart    String?
  frame        String?
  take         String?
  takeStatus   String?
  takeRuntime  String?
  /// Файлы камер: JSON-массив строк длиной cameraCount проекта
  cameraFiles  Json?
  shotSize     String?
  sortOrder    Int     @default(0)

  sceneFact ProductionReportSceneFact @relation(fields: [sceneFactId], references: [id], onDelete: Cascade)

  @@index([sceneFactId, sortOrder])
}

enum ProductionWorkKind {
  ACTOR
  RESOURCE
  TRANSPORT
  LOCATION
}

/// Факт работы актёра/ресурса/транспорта/локации в производственном отчёте.
model ProductionReportWorkRow {
  id                 String             @id @default(cuid())
  reportId           String
  kind               ProductionWorkKind
  actorId            String?
  resourceItemId     String?
  locationId         String?
  /// Стабильный ключ для сидирования (transport:id / resourceCall:cat::name / …)
  sourceKey          String
  displayName        String
  categoryLabel      String?
  factStart          String?
  factEnd            String?
  /// Т/О — текущий обед (не было часового перерыва)
  lunchSkipped       Boolean            @default(false)
  workedMin          Int?
  factOvertimeMin    Int?
  payableOvertimeMin Int?
  shiftHoursMin      Int?
  unpaidOvertimeMin  Int?
  shiftRate          Decimal?           @db.Decimal(12, 2)
  forceMajeurePct    Decimal?           @db.Decimal(6, 2)
  shiftPay           Decimal?           @db.Decimal(14, 2)
  overtimePay        Decimal?           @db.Decimal(14, 2)
  extrasPay          Decimal?           @db.Decimal(14, 2)
  totalPay           Decimal?           @db.Decimal(14, 2)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  report  ProductionReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor   Actor?                      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  item    ResourceItem?               @relation(fields: [resourceItemId], references: [id], onDelete: SetNull)
  location Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  extras  ProductionReportWorkExtra[]
  payment Payment?

  @@unique([reportId, sourceKey])
  @@index([reportId, sortOrder])
  @@index([actorId])
  @@index([resourceItemId])
}

model ProductionReportWorkExtra {
  id          String   @id @default(cuid())
  workRowId   String
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workRow ProductionReportWorkRow @relation(fields: [workRowId], references: [id], onDelete: Cascade)

  @@index([workRowId])
}

/// Выплата, рассчитанная из факта смены (источник для гонораров / actuals).
model Payment {
  id             String            @id @default(cuid())
  projectId      String
  shootDayId     String?
  workRowId      String?           @unique
  actorId        String?
  resourceItemId String?
  category       FinanceOpCategory @default(OTHER)
  title          String
  amount         Decimal           @db.Decimal(14, 2)
  paymentDate    DateTime
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shootDay ShootDay?               @relation(fields: [shootDayId], references: [id], onDelete: SetNull)
  workRow  ProductionReportWorkRow? @relation(fields: [workRowId], references: [id], onDelete: SetNull)
  actor    Actor?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, paymentDate])
  @@index([shootDayId])
  @@index([actorId])
}

model Actor {
  id               String          @id @default(cuid())
  projectId        String
  characterId      String?
  lastName         String
  firstName        String?
  middleName       String?
  gender           Gender?
  contractorType   ContractorType  @default(UNKNOWN)
  roleType         ActorRoleType   @default(SUPPORTING)
  phone1           String?
  phone2           String?
  email            String?
  agentName        String?
  agentPhone       String?
  agentEmail       String?
  carPickupTime    String?
  arrivalTime      String?
  pickupOffsetMin  Int?
  tags             String?
  specialConditions String?
  shiftRate        Decimal?        @db.Decimal(12, 2)
  shiftHoursMin    Int?
  unpaidOvertimeMin Int?
  forceMajeurePct  Decimal?          @db.Decimal(6, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id])
  overtimeRates ActorOvertimeRate[]
  extraPayments ActorExtraPayment[]
  financeOps    FinanceOperation[]
  shootDayCalls ShootDayActorCall[]
  availabilityRows ActorAvailabilityRow[]
  workRows      ProductionReportWorkRow[]
  payments      Payment[]

  @@index([projectId])
}

model ActorAvailabilityRow {
  id              String   @id @default(cuid())
  projectId       String
  actorId         String?
  castingPersonId String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor         Actor?                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  castingPerson CastingPerson?         @relation(fields: [castingPersonId], references: [id], onDelete: Cascade)
  days          ActorAvailabilityDay[]

  @@unique([projectId, actorId])
  @@unique([projectId, castingPersonId])
  @@index([projectId, sortOrder])
}

model ActorAvailabilityDay {
  id      String                  @id @default(cuid())
  rowId   String
  date    DateTime                @db.Date
  status  ActorAvailabilityStatus @default(UNSET)
  comment String?

  row ActorAvailabilityRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@unique([rowId, date])
  @@index([date])
}

model ActorOvertimeRate {
  id              String   @id @default(cuid())
  actorId         String
  hourNumber      Int
  percentRate     Decimal? @db.Decimal(6, 2)
  amount          Decimal? @db.Decimal(12, 2)
  forceMajeurePct Decimal? @db.Decimal(6, 2)
  forceMajeureAmt Decimal? @db.Decimal(12, 2)
  totalWithFk     Decimal? @db.Decimal(12, 2)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, hourNumber])
}

model ActorExtraPayment {
  id              String   @id @default(cuid())
  actorId         String
  paymentDate     DateTime?
  amount          Decimal  @db.Decimal(12, 2)
  forceMajeurePct Decimal? @db.Decimal(6, 2)
  forceMajeureAmt Decimal? @db.Decimal(12, 2)
  totalWithFk     Decimal? @db.Decimal(12, 2)
  description     String?

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  projectId  String?
  userId     String
  entityType String
  entityId   String
  action     AuditAction
  summary    String?
  changes    Json?
  createdAt  DateTime    @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

model ScriptVersion {
  id              String                  @id @default(cuid())
  projectId       String
  versionNumber   Int
  title           String?
  note            String?
  isCurrent       Boolean                 @default(false)
  isLocked        Boolean                 @default(false)
  sourceType      ScriptVersionSourceType @default(MANUAL)
  sourceVersionId String?
  createdById     String
  createdAt       DateTime                @default(now())

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User            @relation(fields: [createdById], references: [id])
  sourceVersion ScriptVersion?  @relation("ScriptVersionCopy", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedFrom   ScriptVersion[] @relation("ScriptVersionCopy")
  blocks        ScriptBlock[]
  comments      ScriptComment[]
  importJobs    ScriptImportJob[]

  @@unique([projectId, versionNumber])
  @@index([projectId, isCurrent])
  @@index([createdById])
}

model ScriptBlock {
  id              String          @id @default(cuid())
  projectId       String
  scriptVersionId String
  sceneId         String?
  type            ScriptBlockType
  content         String          @default("")
  contentHtml     String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptVersion ScriptVersion @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade)
  scene         Scene?        @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([scriptVersionId, sortOrder])
  @@index([projectId, scriptVersionId])
  @@index([sceneId])
}

model ScriptComment {
  id              String              @id @default(cuid())
  scriptVersionId String
  startBlockId    String
  endBlockId      String
  rangeStart      Int                 @default(0)
  rangeEnd        Int                 @default(0)
  content         String
  authorId        String
  parentCommentId String?
  status          ScriptCommentStatus @default(OPEN)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  scriptVersion ScriptVersion   @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade)
  author        User            @relation(fields: [authorId], references: [id])
  parent        ScriptComment?  @relation("ScriptCommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       ScriptComment[] @relation("ScriptCommentThread")

  @@index([scriptVersionId])
  @@index([startBlockId])
  @@index([authorId])
  @@index([parentCommentId])
}

model ScriptImportJob {
  id              String   @id @default(cuid())
  projectId       String
  scriptVersionId String?
  fileName        String
  status          String   @default("pending")
  timingMethod    String?
  showComparison  Boolean  @default(true)
  previewData     Json?
  createdAt       DateTime @default(now())

  scriptVersion ScriptVersion? @relation(fields: [scriptVersionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scriptVersionId])
}

enum BudgetCategory {
  CAST
  CREW
  EQUIPMENT
  LOCATIONS
  TRANSPORT
  CATERING
  POST
  OTHER
}

model BudgetLine {
  id          String         @id @default(cuid())
  projectId   String
  category    BudgetCategory @default(OTHER)
  title       String
  description String?
  quantity    Decimal        @default(1) @db.Decimal(12, 2)
  unitCost    Decimal        @default(0) @db.Decimal(14, 2)
  planned     Decimal        @default(0) @db.Decimal(14, 2)
  actual      Decimal        @default(0) @db.Decimal(14, 2)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
  @@index([projectId, sortOrder])
}

enum FinanceOpType {
  INCOME
  EXPENSE
}

enum FinanceOpCategory {
  CAST_PAY
  CREW_PAY
  VENDOR
  LOCATION
  EQUIPMENT
  TRANSPORT
  CATERING
  GRANT
  SPONSOR
  OTHER
}

model FinanceOperation {
  id           String            @id @default(cuid())
  projectId    String
  type         FinanceOpType
  category     FinanceOpCategory @default(OTHER)
  title        String
  amount       Decimal           @db.Decimal(14, 2)
  operationDate DateTime
  counterparty String?
  notes        String?
  actorId      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   Actor?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, operationDate])
  @@index([projectId, type])
  @@index([actorId])
}

enum PostStage {
  INGEST
  EDIT
  VFX
  COLOR
  SOUND
  GRAPHICS
  DELIVERY
}

enum PostTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum CloudProvider {
  GOOGLE_DRIVE
  YANDEX_DISK
}

model PostTask {
  id            String         @id @default(cuid())
  projectId     String
  stage         PostStage      @default(EDIT)
  status        PostTaskStatus @default(TODO)
  title         String
  episodeNumber Int?
  assignee      String?
  dueDate       DateTime?
  notes         String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stage])
  @@index([projectId, status])
  @@index([projectId, sortOrder])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CloudConnection {
  id           String        @id @default(cuid())
  userId       String
  provider     CloudProvider
  accountEmail String?
  accountLabel String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileLinks CloudFileLink[]

  @@unique([userId, provider])
  @@index([userId])
}

model CloudFileLink {
  id           String        @id @default(cuid())
  projectId    String
  connectionId String?
  provider     CloudProvider
  externalId   String
  path         String?
  name         String
  mimeType     String?
  sizeBytes    BigInt?
  webUrl       String?
  notes        String?
  createdAt    DateTime      @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection CloudConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([connectionId])
}
