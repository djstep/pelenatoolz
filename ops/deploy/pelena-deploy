#!/bin/bash
# Обновление рабочего сайта одной командой.
#   sudo pelena-deploy            из ветки main
#   sudo pelena-deploy <ветка>    из другой ветки
# Порядок: свежая копия базы, код, образы, миграции, перезапуск, проверка ответа сайта.
# Если копия не удалась, обновление не начинается и сайт не трогается.
set -Eeuo pipefail
[ "$(id -u)" = 0 ] || { echo "Запустите так: sudo pelena-deploy"; exit 1; }
BRANCH=${1:-main}
OWNER=pelena_admin
PROJECT=/home/$OWNER/pelena
STAMP=/mnt/data/backups/last-success
ROLES=/usr/local/lib/pelena-backup/db-roles.sql
SITE_CHECK=http://127.0.0.1:3000/ru/invite/none

as_owner() { sudo -u "$OWNER" -H "$@"; }

exec 8>/run/lock/pelena-deploy.lock
flock -n 8 || { echo "Обновление уже выполняется"; exit 1; }

cd "$PROJECT"
[ -z "$(as_owner git status --porcelain)" ] || {
  echo "В папке проекта есть локальные изменения. Обновление не начато."
  exit 1
}
PREVIOUS=$(as_owner git rev-parse --short HEAD)
echo "Сейчас на сервере: $PREVIOUS"

echo "1/6 Свежая копия базы и файлов"
BEFORE=$(cat "$STAMP" 2>/dev/null || true)
if ! systemctl start pelena-backup.service; then
  echo "Копия не удалась. Обновление не начато, сайт не тронут."
  echo "Причина: journalctl -u pelena-backup.service -n 30"
  exit 1
fi
if [ "$(cat "$STAMP" 2>/dev/null || true)" = "$BEFORE" ]; then
  echo "Отметка копии не обновилась. Обновление не начато, сайт не тронут."
  exit 1
fi

echo "2/6 Код из ветки $BRANCH"
as_owner git fetch --quiet origin "$BRANCH"
TARGET=$(as_owner git rev-parse FETCH_HEAD)
if ! as_owner git cat-file -e "$TARGET:docker-compose.prod.yml" 2>/dev/null; then
  echo "В ветке $BRANCH нет docker-compose.prod.yml: похоже, настройки сервера туда ещё не слиты."
  echo "Обновление не начато, сайт не тронут."
  exit 1
fi
if as_owner git merge-base --is-ancestor HEAD "$TARGET"; then
  as_owner git checkout --quiet -B "$BRANCH" "$TARGET"
elif as_owner git merge-base --is-ancestor "$TARGET" HEAD; then
  echo "На сервере код новее ветки $BRANCH, код не меняю."
else
  echo "История на сервере и в $BRANCH разошлась. Обновление не начато, сайт не тронут."
  exit 1
fi
CURRENT=$(as_owner git rev-parse --short HEAD)
echo "Новый код: $CURRENT"
bash ops/backup/install.sh > /dev/null

failed() {
  echo
  echo "$1"
  echo "Было: $PREVIOUS, стало: $CURRENT. Свежая копия уже в облаке."
  echo "Что делать: ops/README.md, раздел про откат."
  exit 1
}

echo "3/6 Сборка образов"
docker compose --profile tools build app migrate || failed "Сборка не удалась. Сайт работает на прежней версии."

echo "4/6 Миграции"
docker compose run --rm -T migrate < /dev/null || failed "Миграции не прошли. Сайт работает на прежней версии."
docker compose exec -T db psql -U pelena -d pelena -X -q -v ON_ERROR_STOP=1 -f - < "$ROLES" \
  || failed "Права базы не применились. Сайт работает на прежней версии."

echo "5/6 Перезапуск сайта"
docker compose up -d app || failed "Сайт не запустился."

echo "6/6 Проверка ответа сайта"
for _ in $(seq 1 45); do
  # Страница читает базу: ответ значит, что сайт работает и вошёл в неё под своей ролью.
  if curl -s -m 5 "$SITE_CHECK" | grep -q 'Приглашение недействительно'; then
    echo "Готово: сайт обновлён с $PREVIOUS до $CURRENT."
    exit 0
  fi
  sleep 2
done
failed "Сайт не отвечает после перезапуска."
