#!/bin/bash
# Проверка копий.
#   pelena-backup-check            письмо, если успешной копии не было дольше MAX_HOURS
#   pelena-backup-check --failed   письмо о сбое, вызывается службой при ошибке копии
#   pelena-backup-check --weekly   письмо «всё работает»: его отсутствие значит, что сломана почта
set -euo pipefail
STAMP=${PELENA_LAST_SUCCESS:-/mnt/data/backups/last-success}
MAX_HOURS=26
HOST=$(hostname)

if [ "${1:-}" = "--failed" ]; then
  RUN=$(systemctl show pelena-backup.service -p InvocationID --value)
  {
    echo "Копия на сервере $HOST не выполнена: $(date '+%d.%m.%Y %H:%M')."
    echo
    echo "Записи журнала этого запуска:"
    # Длинные строки похожи на ключи: в письмо они не идут.
    journalctl "_SYSTEMD_INVOCATION_ID=$RUN" -o cat --no-pager 2>&1 | tail -15 \
      | sed -E 's/[A-Za-z0-9+\/=_-]{32,}/<скрыто>/g'
  } | /usr/local/sbin/pelena-notify "PELENA: копия не выполнена"
  exit 0
fi

LAST=""
if [ -s "$STAMP" ]; then
  LAST=$(date -d "$(cat "$STAMP")" +%s 2>/dev/null || true)
fi
NOW=$(date +%s)
HOURS=$(( (NOW - ${LAST:-0}) / 3600 ))

if [ "${1:-}" = "--weekly" ]; then
  {
    echo "Еженедельная проверка уведомлений PELENA: письма доходят."
    echo "Сервер: $HOST."
    if [ -n "$LAST" ]; then
      echo "Последняя успешная копия: $HOURS ч назад."
    else
      echo "Последняя успешная копия: неизвестно."
    fi
    echo "Копий на диске: $(find /mnt/data/backups/db -type f -name '*.dump.age' 2>/dev/null | wc -l)."
    echo "Свободно на диске копий: $(df -h --output=avail /mnt/data | tail -1 | tr -d ' ')."
    echo "Свободно на системном диске: $(df -h --output=avail / | tail -1 | tr -d ' ')."
  } | /usr/local/sbin/pelena-notify "PELENA: копии, недельная сводка"
  exit 0
fi

if [ -z "$LAST" ]; then
  AGE="неизвестно: отметки об успешной копии нет"
elif [ "$HOURS" -ge "$MAX_HOURS" ]; then
  AGE="$HOURS ч назад"
else
  echo "Копия свежая: $HOURS ч назад"
  exit 0
fi

printf 'На сервере %s давно не было успешной копии.\nПоследняя: %s.\nПроверка: %s.\n' \
  "$HOST" "$AGE" "$(date '+%d.%m.%Y %H:%M')" \
  | /usr/local/sbin/pelena-notify "PELENA: давно не было копии"
