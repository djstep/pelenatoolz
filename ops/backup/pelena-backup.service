[Unit]
Description=PELENA: ежедневная копия базы и файлов
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/mnt/data
OnFailure=pelena-backup-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pelena-backup
Nice=10
# Без предела зависшая копия молчала бы: письма о сбое нет, новая копия не запускается.
TimeoutStartSec=6h
